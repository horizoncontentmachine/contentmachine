# Obbligatoria (solo server-side, mai esposta al browser)
OPENAI_API_KEY=sk-...

# Opzionali
# OPENAI_IMAGE_MODEL=gpt-image-2

# Password gate (consigliato se esponi l'app pubblicamente, es. via Cloudflare Tunnel)
# Attivo solo se APP_PASSWORD è valorizzata.
# APP_USER=admin
# APP_PASSWORD=scegli-una-password

# URL pubblico (usato per il redirect OAuth di Google Drive quando sei dietro tunnel)
# APP_URL=https://xxxx.trycloudflare.com

# Google Drive OAuth (in alternativa all'inserimento da Impostazioni)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
